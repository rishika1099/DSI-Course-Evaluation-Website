# Copy this file to .streamlit/secrets.toml and fill in real values.
# Do NOT commit secrets.toml — it's in .gitignore.

sheet_id = "YOUR_GOOGLE_SHEET_ID"
worksheet_name = "Form_Responses"

HF_API_TOKEN = "hf_..."   # optional, enables AI comment summaries

[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@your-gcp-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
